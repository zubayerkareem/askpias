# Copy to .env and fill in. Used by docker-compose.yml.

# Public addresses (also used for CORS and payment return URLs)
SITE_URL=https://askpias.com
API_URL=https://api.askpias.com

# Generate with: php artisan key:generate --show
APP_KEY=

# Database
DB_DATABASE=askpias
DB_USERNAME=askpias
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# First admin (created automatically on first start; safe to keep on restarts)
ADMIN_EMAIL=admin@askpias.com
ADMIN_NAME=Pias Ahmed
ADMIN_PASSWORD=change-me-now

# Demo content is seeded only when the notes table is empty
SEED_DEMO=true

# Optional
GTM_ID=
